{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeeklyTrainingAnalysis",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "week": { "type": "string" },
    "dateRange": { "type": "string" },
    "gymCount": { "type": "integer", "minimum": 0 },
    "sleepAverage": {
      "type": ["string", "null"],
      "description": "Use null when not logged."
    },
    "moodTrend": {
      "type": ["string", "null"],
      "description": "Use null when not logged."
    },
    "recoveryStatus": {
      "type": ["string", "null"],
      "description": "Use null when not logged."
    },
    "progressiveOverload": { "type": "string" },
    "volumeTrend": { "type": "string" },
    "formAndMmc": { "type": "string" },
    "painOrRiskSignals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "whatWorked": {
      "type": "array",
      "items": { "type": "string" }
    },
    "whatFailedOrNeedsAttention": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nextWeekAdjustments": {
      "type": "array",
      "items": { "type": "string" }
    },
    "missingData": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "week",
    "dateRange",
    "gymCount",
    "sleepAverage",
    "moodTrend",
    "recoveryStatus",
    "progressiveOverload",
    "volumeTrend",
    "formAndMmc",
    "painOrRiskSignals",
    "whatWorked",
    "whatFailedOrNeedsAttention",
    "recommendations",
    "nextWeekAdjustments",
    "missingData"
  ]
}
