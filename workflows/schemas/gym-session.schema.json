{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GymSessionExtraction",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "description": "ISO week label, for example 2026-W05."
    },
    "dateRange": {
      "type": "string",
      "description": "Date range covered by the extraction."
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "date": { "type": "string" },
          "file": { "type": "string" },
          "dayNumber": { "type": ["string", "null"] },
          "focus": { "type": ["string", "null"] },
          "duration": { "type": ["string", "null"] },
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "setsXReps": { "type": ["string", "null"] },
                "weight": { "type": ["string", "null"] },
                "rpe": { "type": ["string", "null"] },
                "notes": { "type": ["string", "null"] }
              },
              "required": ["name", "setsXReps", "weight", "rpe", "notes"]
            }
          },
          "formNotes": { "type": ["string", "null"] },
          "painOrDiscomfort": { "type": ["string", "null"] },
          "doms": { "type": ["string", "null"] },
          "nextAdjustment": { "type": ["string", "null"] }
        },
        "required": [
          "date",
          "file",
          "dayNumber",
          "focus",
          "duration",
          "exercises",
          "formNotes",
          "painOrDiscomfort",
          "doms",
          "nextAdjustment"
        ]
      }
    },
    "missingData": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["week", "dateRange", "sessions", "missingData"]
}

